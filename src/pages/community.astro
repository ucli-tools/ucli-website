---
import Layout from '../layouts/Layout.astro';
import Masthead from '../components/Masthead.astro';
import IndexList from '../components/IndexList.astro';

const rows = [
  { name: 'GitHub', href: 'https://github.com/ucli-tools', desc: 'View source code, report issues, and contribute' },
  { name: 'Discussions', href: 'https://github.com/ucli-tools/community/discussions', desc: 'Ask questions and share ideas with the community' },
  { name: 'Contributing', href: 'https://docs.ucli.tools/community/contributing', desc: 'Learn how to contribute to UCLI Tools' },
];
---

<Layout title="Community - UCLI Tools">
  <Masthead interior lead="Connect with developers building the future of CLI tools">
    <Fragment>Join Our<br />Community</Fragment>
    <Fragment slot="actions">
      <a class="u-btn" href="https://github.com/ucli-tools">GitHub</a>
      <a class="u-link" href="https://github.com/ucli-tools/community/discussions">Discussions →</a>
    </Fragment>
  </Masthead>

  <div class="u-wrap">
    <IndexList label="Community links" rows={rows} />
  </div>
</Layout>
