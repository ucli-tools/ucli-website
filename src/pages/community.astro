---
import Layout from '../layouts/Layout.astro';
import Features from '../components/Features.astro';

const rows = [
  { name: 'GitHub', href: 'https://github.com/ucli-tools', desc: 'View source code, report issues, and contribute' },
  { name: 'Discussions', href: 'https://github.com/ucli-tools/community/discussions', desc: 'Ask questions and share ideas with the community' },
  { name: 'Contributing', href: 'https://docs.ucli.tools/community/contributing', desc: 'Learn how to contribute to UCLI Tools' },
];
---

<Layout title="Community - UCLI Tools">
  <div class="u-wrap"><div class="u-page u-ipage">
    <h1>Join Our Community</h1>
    <p class="u-lede">Connect with developers building the future of CLI tools</p>
    <p class="u-next"><a href="https://github.com/ucli-tools">GitHub</a><a href="https://github.com/ucli-tools/community/discussions">Discussions</a></p>
    <section class="u-section">
      <Features label="Community links" rows={rows} />
    </section>
  </div></div>
</Layout>
