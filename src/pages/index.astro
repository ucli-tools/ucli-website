---
import Layout from '../layouts/Layout.astro';
import Command from '../components/Command.astro';
import ToolList from '../components/ToolList.astro';
import Steps from '../components/Steps.astro';
import { INSTALL_CMD } from '../data/commands';
import { getTools, PAGES, repoUrl } from '../data/registry';

const registry = await getTools();
const start = ['mdtexpdf', 'mdaudiobook', 'docx2md', 'gits'];
const rows = start.flatMap((n) => {
  const t = registry.find((r) => r.name === n);
  return t ? [{ name: t.name, href: PAGES.includes(t.name) ? `/tools/${t.name}` : repoUrl(t.name), desc: t.desc, code: `ucli build ${t.name}` }] : [];
});

const steps = [
  { head: 'A tool gets a new commit on main.', body: 'If it has tests, they run first.' },
  { head: "The registry opens a pull request that moves the tool's pin to that commit.", body: 'A tool with tests gets there only after its tests pass.' },
  { head: 'A maintainer merges it.', body: 'The new pin is official.' },
  { head: 'You run <code>ucli update</code>.', body: 'Your machine builds that exact commit.' },
];
---

<Layout title="UCLI Tools - Professional CLI Tools for Developers">
  <div class="u-wrap">
    <div class="u-hero">
      <div>
        <h1 style="font-size:var(--u-fs-h1-home);font-weight:700;letter-spacing:-.03em;line-height:1.04;max-width:17ch">Every tool built at one exact commit.</h1>
        <p class="u-lede">ucli is a small bash CLI that installs and updates a family of command-line tools. Each tool is built at the exact commit the registry pins. Pins move by pull request, after checks on the new commit.</p>
        <Command bar label="Install" cmd={INSTALL_CMD}>
          <p class="u-install__note">A new install goes into <code>~/.local/bin</code> and never asks for sudo. Linux and macOS; on Windows, use WSL.</p>
        </Command>
        <p class="u-next"><a href="/tools">Browse the tools</a><a href="https://docs.ucli.tools">Read the docs</a></p>
      </div>
      <figure class="u-term">
        <figcaption>What an update looks like</figcaption>
        <div class="u-code"><div class="u-code__x" data-scroll-x tabindex="0" role="region" aria-label="Example of ucli update"><pre><span class="u-o-prompt">$ </span>ucli update
[UPDATE] Fetching repository list...
[UPDATE] gits is up to date (bad4390f).
[UPDATE] Rebuilding 1 tool(s): mdtexpdf
[UPDATE] Update completed!</pre></div></div>
        <p class="u-term__n">Some lines are left out.</p>
      </figure>
    </div>

    <section class="u-section" id="tools">
      <h2>Start with these tools</h2>
      <ToolList rows={rows} label="Start with these tools" />
      <p class="u-more"><a href="https://registry.ucli.tools/">See all {registry.length} official tools in the registry</a></p>
    </section>

    <section class="u-section" id="updates">
      <h2>How updates reach you</h2>
      <Steps items={steps} />
    </section>
  </div>
</Layout>

<style>
  .u-term__n { margin: 8px 0 0; font-size: var(--u-fs-small); color: var(--u-ink-2); }
</style>
