---
import ToolPage from '../../components/ToolPage.astro';
import IndexList from '../../components/IndexList.astro';

const features = [
  { name: "LaTeX Quality", desc: "Professional typesetting with mathematical formulas, tables, and advanced formatting" },
  { name: "Batch Conversion", desc: "Convert multiple Markdown files to PDF in a single command" },
  { name: "Beautiful Output", desc: "Stunning PDFs with syntax highlighting, proper formatting, and professional appearance" },
];
---

<ToolPage
  title="mdtexpdf - Markdown to PDF Converter | UCLI Tools"
  name="mdtexpdf"
  summary="Convert Markdown documents to professional PDF with LaTeX quality typesetting"
  installCmd={'ucli build mdtexpdf'}
  docsHref="https://docs.ucli.tools/tools/mdtexpdf"
>
  <Fragment slot="title">mdtexpdf<br />Markdown to PDF</Fragment>

  <h3>Why mdtexpdf?</h3>
  <p class="u-lead">Professional PDF generation from your Markdown files</p>
  <IndexList rows={features} label="Why mdtexpdf?" />
</ToolPage>
