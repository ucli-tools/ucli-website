---
import ToolPage from '../../components/ToolPage.astro';
import Features from '../../components/Features.astro';

const features = [
  { name: "Natural Speech", desc: "Narration by a neural voice that runs on your own computer, sentence by sentence" },
  { name: "Checked First", desc: "A check step flags what a voice cannot speak, and every name it would guess, before any audio is made" },
  { name: "Multiple Formats", desc: "One MP3 per chapter, and an M4B audiobook with chapter marks and a cover" },
];
---

<ToolPage
  tagline="Markdown to Audiobook"
  title="mdaudiobook - Markdown to Audiobook Converter | UCLI Tools"
  name="mdaudiobook"
  summary="Transform your Markdown content into engaging audiobooks and podcasts"
  installCmd={'ucli build mdaudiobook'}
  docsHref="https://docs.ucli.tools/tools/mdaudiobook"
>
  <h2>Why mdaudiobook?</h2>
  <p>Turn your written content into captivating audio experiences</p>
  <Features rows={features} label="Why mdaudiobook?" />
</ToolPage>
