---
import ToolPage from '../../components/ToolPage.astro';
import IndexList from '../../components/IndexList.astro';

const features = [
  { name: "Natural Speech", desc: "High-quality text-to-speech with natural-sounding voices and proper intonation" },
  { name: "Podcast Ready", desc: "Generate podcast episodes from your Markdown content with proper formatting" },
  { name: "Multiple Formats", desc: "Output in various audio formats including MP3, WAV, and more" },
];
---

<ToolPage
  title="mdaudiobook - Markdown to Audiobook Converter | UCLI Tools"
  name="mdaudiobook"
  summary="Transform your Markdown content into engaging audiobooks and podcasts"
  installCmd={'ucli build mdaudiobook'}
  docsHref="https://docs.ucli.tools/tools/mdaudiobook"
>
  <Fragment slot="title">mdaudiobook<br />Markdown to Audiobook</Fragment>

  <h3>Why mdaudiobook?</h3>
  <p class="u-lead">Turn your written content into captivating audio experiences</p>
  <IndexList rows={features} label="Why mdaudiobook?" />
</ToolPage>
