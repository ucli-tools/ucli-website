---
import ToolPage from '../../components/ToolPage.astro';
import IndexList from '../../components/IndexList.astro';
import { INSTALL_CMD } from '../../data/commands';

const features = [
  { name: "One-Command Installs", desc: "Install any tool with a single command. No complex setup or dependencies to worry about." },
  { name: "Dependency Management", desc: "Automatic dependency resolution and installation. UCLI handles all the complexity for you." },
  { name: "Version Management", desc: "Keep your tools up-to-date with automatic version management and easy upgrades." },
  { name: "Cross-Platform", desc: "Works seamlessly on Linux, macOS, and Windows. Same commands, same experience everywhere." },
  { name: "Lightning Fast", desc: "Optimized for speed with minimal overhead. Get your tools running in seconds." },
  { name: "Secure & Trusted", desc: "Open source and transparent. All tools are verified and dependencies are managed securely." },
];
---

<ToolPage
  title="UCLI - Universal CLI Tool Manager | UCLI Tools"
  name="ucli"
  summary="The universal command-line interface for managing and installing all your development tools"
  installCmd={INSTALL_CMD}
  docsHref="https://docs.ucli.tools/tools/ucli"
>
  <Fragment slot="title">UCLI<br />Tool Manager</Fragment>

  <h3>Why UCLI?</h3>
  <p class="u-lead">One tool to rule them all - manage your entire CLI toolkit</p>
  <IndexList rows={features} label="Why UCLI?" />
</ToolPage>
