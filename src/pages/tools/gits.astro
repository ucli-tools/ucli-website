---
import ToolPage from '../../components/ToolPage.astro';
import Features from '../../components/Features.astro';
import Command from '../../components/Command.astro';

const diagram = [
  'Your Terminal (Local)',
  '        ↓ GitS',
  '┌─────────────────────────────┐',
  '│ Multi-Platform Git Ops      │',
  '│                             │',
  '│ Forgejo + Gitea + GitHub    │',
  '│ Batch Operations            │',
  '│ AI-Powered Commits          │',
  '│ No More Manual Git Work     │',
  '└─────────────────────────────┘',
].join('\n');

const features = [
  { name: 'Multi-Platform Support', desc: "Works seamlessly with Forgejo, Gitea, and GitHub. One tool for all your repositories, regardless of where they're hosted." },
  { name: 'Batch Operations', desc: 'Push, pull, fetch, and manage status across all orgs and repos in your directory tree with a single command.' },
  { name: 'AI-Powered Commits', desc: 'Generate meaningful commit messages automatically with AI integration. Just run', code: 'gits push-all -py' },
  { name: 'PR Batch Management (new)', desc: 'Create and merge pull requests across all orgs and repos at once. Perfect for multi-org feature rollouts and updates.' },
  { name: 'Smart Diff Detection (new)', desc: "Only acts on repositories with actual changes. No wasted effort on repos that haven't changed - GitS knows the difference." },
  { name: 'Lightning Fast Workflows', desc: 'Combine multiple git operations into single commands. What used to take minutes now takes seconds.' },
];

const workflow = [
  { t: '# Create feature branches (auto-detects default)', c: true },
  { t: 'gits set-all --suffix -feature' },
  { t: '# AI-powered commits via Pal', c: true },
  { t: 'gits push-all -py' },
  { t: "# PRs to each repo's default branch", c: true },
  { t: 'gits pr create-all --title "Feature X" --suffix -feature' },
  { t: '# Merge all and cleanup', c: true },
  { t: 'gits pr merge-all --delete-branch' },
];

const usecases = [
  { name: 'Microservices Architecture', desc: 'Managing 20+ microservice repos across multiple orgs? Clone them all, update shared dependencies, and create PRs across every service in minutes, not hours.', lines: ['gits clone-all myorg && gits pr create-all --title "Bump deps"'] },
  { name: 'Multi-Repo Monorepo Feel', desc: 'Get the benefits of a monorepo without the complexity. Manage related projects together while keeping repositories separate.', lines: ['gits status-all && gits push-all -py'] },
  { name: 'Open Source Maintenance', desc: 'Maintain multiple open source projects across GitHub, Gitea, and Forgejo. Fetch all issues, sync changes, and manage releases efficiently.', lines: ['gits fetch-issues-all --state open'] },
  { name: 'Cross-Platform Teams', desc: 'Your team uses GitHub, a client uses Gitea, and your infra is on Forgejo? No problem. GitS speaks all three fluently.', lines: [{ t: 'gits login' }, { t: '# Works with any platform', c: true }] },
];
---

<ToolPage
  tagline="Git Workflow at Lightning Speed"
  title="GitS - Git Workflow Automation | UCLI Tools"
  name="gits"
  summary="AI-powered commits, batch PR management, and multi-org workflows. Manage all your repos across GitHub, Gitea, and Forgejo with single commands."
  installCmd="ucli build gits"
  installLabel="Quick Install"
  kicker="Git in the AI Era"
  docsHref="https://docs.ucli.tools/tools/gits"
  github="https://github.com/ucli-tools/gits"
>
  <p slot="name">Works seamlessly with Forgejo, Gitea, and GitHub</p>

  <p slot="synopsis">One command to install. Zero configuration needed.</p>

  <h2>Why GitS?</h2>
  <p>Streamline your git workflow with professional automation</p>
  <Features rows={features} label="Why GitS?" />

  <h2>How it works</h2>
  <div class="u-code"><div class="u-code__x" data-scroll-x tabindex="0" role="region" aria-label="Diagram: your terminal runs GitS, which handles multi-platform git operations: Forgejo, Gitea and GitHub, batch operations, AI-powered commits, and no more manual git work."><pre>{diagram}</pre></div></div>
  <p>Professional git workflow in seconds</p>
  <div class="u-split">
    <div>
      <h3>The Problem</h3>
      <ul>
        <li>Manual git operations are repetitive and error-prone</li>
        <li>Multi-repo workflows require complex scripting</li>
        <li>Different platforms need different commands</li>
      </ul>
    </div>
    <div>
      <h3>The Solution</h3>
      <ul>
        <li><strong>Unified interface:</strong> Same commands for all platforms</li>
        <li><strong>Batch operations:</strong> Handle multiple repos simultaneously</li>
        <li><strong>AI integration:</strong> Smart commit messages and suggestions</li>
        <li><strong>Cross-platform:</strong> Works on Linux and macOS; on Windows, use WSL</li>
      </ul>
    </div>
  </div>

  <h2>Powered by Pal</h2>
  <p>
    GitS integrates with <strong>Pal</strong> by Scott Yeager for AI-powered commit message generation.
    Run <code>gits push-all -py</code> to automatically generate meaningful commit messages using AI.
  </p>
  <p><a href="https://github.com/scottyeager/Pal/" target="_blank" rel="noopener noreferrer">Check out Pal on GitHub →</a></p>

  <Fragment slot="examples">
    <h3>Complete Workflow in 4 Commands</h3>
    <p>From feature branch to merged PR across your entire organization</p>
    <Command label="~/projects" lines={workflow} />
    <p>That's it. Multiple orgs, multiple repos, multiple platforms, one workflow.</p>

    <h3>Built for Real Workflows</h3>
    <p>See how teams use GitS to move faster</p>
    <ul class="u-feat">
      {usecases.map((u) => (
        <li>
          <b>{u.name}</b>
          <p>{u.desc}</p>
          <Command lines={u.lines} label={u.name} />
        </li>
      ))}
    </ul>
  </Fragment>
</ToolPage>
