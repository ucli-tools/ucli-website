---
import Layout from '../layouts/Layout.astro';
import Command from '../components/Command.astro';
import ToolList from '../components/ToolList.astro';
import { getTools, PAGES, repoUrl } from '../data/registry';

const registry = await getTools();
const rows = registry.map((t) => ({
  name: t.name,
  href: PAGES.includes(t.name) ? `/tools/${t.name}` : repoUrl(t.name),
  desc: t.desc,
  code: `ucli build ${t.name}`,
}));
---

<Layout title="UCLI Tools - Available Tools">
  <div class="u-wrap"><div class="u-page u-ipage">
    <h1>Available CLI Tools</h1>
    <p class="u-lede">Professional command-line tools for developers</p>
    <p class="u-next"><a href="https://docs.ucli.tools">View documentation</a></p>

    <section class="u-section" id="tools">
      <p>Every tool in the registry. Tools with a page here link to it; the others link to their repository.</p>
      <ToolList rows={rows} label="Registry tools" />
    </section>

    <section class="u-section" id="install-all">
      <p>ucli can build several tools in one command</p>
      <Command label="Install multiple tools at once" lines={['ucli build gits mdtexpdf mdaudiobook']} />
    </section>
  </div></div>
</Layout>
