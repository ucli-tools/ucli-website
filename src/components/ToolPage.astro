---
// A tool page: a plain page (design 7.1). h1 with the tool name, a lede, the install bar, then the
// sections as h2 with hairline rules, and "Read the docs" and "View on GitHub" as text links.
// Slots: "synopsis" (under the install bar), "name" (a line under the lede), default (the body),
// "options" and "examples" (a section with no content is left out).
import Layout from '../layouts/Layout.astro';
import Command from './Command.astro';
import { repoUrl } from '../data/registry';

interface Props {
  title: string;       // <title>
  name: string;        // command name
  tagline: string;     // the second line of the old heading
  summary: string;     // one-line description
  installCmd: string;
  installLabel?: string;
  kicker?: string;
  docsHref: string;
  github?: string;
}
const { title, name, tagline, summary, installCmd, installLabel = `Install ${name}`, kicker, docsHref, github = repoUrl(name) } = Astro.props;
const has = (n: string) => Astro.slots.has(n);
---

<Layout title={title}>
  <div class="u-wrap"><div class="u-page u-ipage">
    {kicker && <p class="u-aside">{kicker}</p>}
    <h1 class="u-mono">{name}</h1>
    <p class="u-sub">{tagline}</p>
    <p class="u-lede">{summary}</p>
    {has('name') && <slot name="name" />}
    <Command bar label={installLabel} cmd={installCmd} />
    {has('synopsis') && <div class="u-synopsis"><slot name="synopsis" /></div>}

    {has('default') && <section class="u-section"><slot /></section>}
    {has('options') && <section class="u-section" id="options"><h2>Options</h2><slot name="options" /></section>}
    {has('examples') && <section class="u-section" id="examples"><h2>Examples</h2><slot name="examples" /></section>}

    <p class="u-next">
      <a href={docsHref}>Read the docs</a>
      <a href={github} target="_blank" rel="noopener noreferrer">View on GitHub</a>
    </p>
  </div></div>
</Layout>

<style is:global>
  .u-synopsis { margin-top: 20px; }
  .u-synopsis p { margin: 0; color: var(--u-ink-2); }
  .u-page .u-next { margin-top: 48px; }
</style>
